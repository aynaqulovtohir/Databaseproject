graph ER {
  graph [layout=neato, overlap=false, sep="+18", splines=true, fontname="DejaVu Sans", fontsize=20, label="Platforma ma'lumotlar bazasining konseptual modeli (ER-diagramma)", labelloc=t, pad=0.4];
  node [fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569"];
  "users_user" [shape=box, style="rounded,filled", fillcolor="#dbeafe", label="Foydalanuvchi\n(admin, o'qituvchi, talaba)"];
  "users_studentgroup" [shape=box, style="rounded,filled", fillcolor="#dbeafe", label="Guruh"];
  "learning_material" [shape=box, style="rounded,filled", fillcolor="#dcfce7", label="Material"];
  "learning_materialfile" [shape=box, style="rounded,filled", fillcolor="#dcfce7", label="Material fayli"];
  "learning_assignment" [shape=box, style="rounded,filled", fillcolor="#dcfce7", label="Topshiriq"];
  "submissions_submission" [shape=box, style="rounded,filled", fillcolor="#ffedd5", label="Yechim"];
  "ai_aianalysis" [shape=box, style="rounded,filled", fillcolor="#ffedd5", label="AI tahlili"];
  "ai_chatmessage" [shape=box, style="rounded,filled", fillcolor="#ffedd5", label="Chat xabari"];
  "grading_grade" [shape=box, style="rounded,filled", fillcolor="#ffedd5", label="Baho"];
  "notifications_telegramaccount" [shape=box, style="rounded,filled", fillcolor="#f3f4f6", label="Telegram hisobi"];
  "notifications_telegramlinkcode" [shape=box, style="rounded,filled", fillcolor="#f3f4f6", label="Telegram bog'lash kodi"];
  "notifications_notification" [shape=box, style="rounded,filled", fillcolor="#f3f4f6", label="Bildirishnoma"];
  "labs_lab" [shape=box, style="rounded,filled", fillcolor="#ede9fe", label="Laboratoriya"];
  "labs_labattempt" [shape=box, style="rounded,filled", fillcolor="#ede9fe", label="Laboratoriya urinishi"];
  "labs_labgrade" [shape=box, style="rounded,filled", fillcolor="#ede9fe", label="Laboratoriya bahosi"];
  r1 [shape=diamond, style=filled, fillcolor="#fef9c3", fontsize=10, label="a'zo"];
  "users_studentgroup" -- r1 [taillabel="0..1", labeldistance=1.6];
  r1 -- "users_user" [headlabel="N", labeldistance=1.6];
  r2 [shape=diamond, style=filled, fillcolor="#fef9c3", fontsize=10, label="yaratadi"];
  "users_user" -- r2 [taillabel="1", labeldistance=1.6];
