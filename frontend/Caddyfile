# Ishchi server veb-serveri. DOMAIN uchun Let's Encrypt sertifikati avtomatik olinadi va yangilanadi;
# http so'rovlar https ga yo'naltiriladi. DOMAIN=localhost bo'lsa, mahalliy sinov sertifikati ishlatiladi.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:31536000}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Material fayllari 20 MB gacha (backend ham tekshiradi)
	request_body /api/* {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}

	# Django admin statik fayllari (backend collectstatic qilgan umumiy hajm)
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# Frontend (SPA): mavjud bo'lmagan yo'llar index.html ga qaytadi
	handle {
		root * /srv/app
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
