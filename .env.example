# Namuna. Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.
SECRET_KEY=bu-yerga-uzun-tasodifiy-satr
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=dbproject
POSTGRES_USER=dbproject
POSTGRES_PASSWORD=bu-yerga-baza-paroli
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Sun'iy intellekt. AI_PROVIDER qaysi xizmat ishlatilishini tanlaydi: gemini yoki anthropic.
# Faqat tanlangan xizmatning kaliti kerak.
AI_PROVIDER=gemini
# Google Gemini: kalitni https://aistudio.google.com/apikey dan olasiz (bepul tarifi bor).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Asosiy model band bo'lsa navbat bilan sinaladigan modellar (vergul bilan)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash
# Anthropic (Claude): kalitni https://console.anthropic.com dan olasiz (pullik).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_CHAT_DAILY_LIMIT=30
# Xarajat hisoboti uchun narx: 1 million token uchun AQSh dollari (0 — bepul tarif, faqat tokenlar ko'rsatiladi)
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0

# Virtual laboratoriya (ixtiyoriy). Talaba SQL kodi bajariladigan alohida baza nomi
# va bitta talaba kuniga oladigan AI maslahatlari soni.
LAB_SANDBOX_DB=lab_sandbox
# Talaba kodi bajariladigan alohida Postgres serveri (docker-compose'dagi lab_db) administratori.
# Parol asosiy baza parolidan farq qilsin, masalan: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LAB_DB_USER=lab_admin
LAB_DB_PASSWORD=bu-yerga-laboratoriya-paroli
LAB_AI_DAILY_LIMIT=40
# Bitta talabaning kuniga AI baholaydigan topshirishlari soni (undan keyin avtomatik baho)
LAB_AI_GRADES_DAILY_LIMIT=20

# Telegram bot. Token va nomni @BotFather orqali olasiz. Nom @ belgisisiz yoziladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# HTTPS (faqat sayt to'liq HTTPS orqali ishlaganda yoqing). HSTS uchun avval kichik qiymat, masalan 3600.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
