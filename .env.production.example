# Ishchi server (internet) uchun .env namunasi. Serverda: cp .env.production.example .env  va qiymatlarni to'ldiring.
# Bu fayl git'ga tushmaydi (.env). Parollarni hech kimga yubormang.
# Tasodifiy parol yaratish: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Domen ---
# Saytning domeni (DNS A-yozuvi shu server IP'siga qaragan bo'lishi kerak). https:// siz yoziladi.
DOMAIN=mb.example.uz
ALLOWED_HOSTS=mb.example.uz
CSRF_TRUSTED_ORIGINS=https://mb.example.uz

# --- Django ---
DEBUG=False
# Kamida 50 belgili tasodifiy qator: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# DIQQAT: o'zgartirilsa, tadqiqot eksportidagi talaba taxalluslari ham o'zgaradi.
SECRET_KEY=bu-yerga-tasodifiy-maxfiy-kalit
# Gunicorn jarayonlari soni: odatda (CPU yadrolari x 2) + 1
GUNICORN_WORKERS=3

# --- Asosiy baza ---
POSTGRES_DB=dbproject
POSTGRES_USER=dbproject
POSTGRES_PASSWORD=bu-yerga-baza-paroli
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Virtual laboratoriya qum qutisi (alohida server, parol asosiy bazanikidan farq qilsin) ---
LAB_SANDBOX_DB=lab_sandbox
LAB_DB_USER=lab_admin
LAB_DB_PASSWORD=bu-yerga-laboratoriya-paroli
LAB_AI_DAILY_LIMIT=40
LAB_AI_GRADES_DAILY_LIMIT=20

# --- Sun'iy intellekt ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.7-flash
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Maslahatlar uchun arzon model (bo'sh — AI_MODEL). Gemini uchun: GEMINI_FAST_MODEL
AI_FAST_MODEL=claude-haiku-5-5
GEMINI_FAST_MODEL=
AI_CHAT_DAILY_LIMIT=30

# --- Telegram bot (ixtiyoriy). Ishlab chiqishdagi bot bilan BIR XIL token ishlatmang. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Monitoring: backend yoki bazalar ishlamay qolsa, Telegram'ni bog'lagan adminlarga xabar (bo'sh — o'chiq)
MONITOR_HEALTH_URL=http://backend:8000/api/health/

# --- Zaxira nusxa ---
# Necha kunlik nusxalar saqlanadi (./backups papkasida)
BACKUP_KEEP_DAYS=14

# --- HTTPS ---
# HSTS: brauzer saytni faqat HTTPS orqali ochadi (soniyalarda, 31536000 = 1 yil).
# Birinchi ishga tushirishda HTTPS to'g'ri ishlashiga ishonch hosil qilguncha 300 qo'yib turish mumkin.
HSTS_MAX_AGE=31536000
